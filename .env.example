# SEPOLIA TESTNET DEPLOYMENT
# Create a copy of this file named ".env" and fill in your values.

# 1. Your Alchemy or Infura RPC URL for Sepolia network
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY"

# 2. Private key of the deployer account (MUST have Sepolia ETH to pay for gas)
# Do NOT include the "0x" prefix if your wallet exports it without one, but Hardhat typically accepts it with or without.
PRIVATE_KEY="YOUR_METAMASK_PRIVATE_KEY"
